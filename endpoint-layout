GET     /v1/vms                   # list all VMs
GET     /v1/vms/{vmid}            # details for a specific VM
POST    /v1/vms                   # provision a new VM
DELETE  /v1/vms/{vmid}            # destroy a VM
POST    /v1/vms/{vmid}/start      # start a VM
POST    /v1/vms/{vmid}/stop       # stop a VM
